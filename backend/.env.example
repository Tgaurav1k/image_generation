PORT=5000
NODE_ENV=development
# true only behind HTTPS; plain HTTP (e.g. Docker IP:port) use false
COOKIE_SECURE=false
# Comma-separated: Vite dev + each public URL where the SPA is served (required for cookies / API).
FRONTEND_ORIGIN=http://localhost:5173,http://YOUR_SERVER_IP:1001

# Database
PGHOST=your_db_host
PGPORT=5432
PGDATABASE=images
PGUSER=your_db_user
PGPASSWORD=your_db_password

# Image Generation API
IMAGE_API_URL=http://your-image-api-host:8030/v1/images/generations
IMAGE_API_KEY=your_api_key_here

# Admin Bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# SuperAdmin Bootstrap
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change_this_password

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# Prompt enhancer (OpenAI-compatible chat completions API)
ENHANCE_API_URL=http://your-llm-host:8003/v1/chat/completions
ENHANCE_API_KEY=
ENHANCE_MODEL=Qwen/Qwen3-8B

# Optional extra superadmin (skipped if either is empty)
HERO_USERNAME=
HERO_PASSWORD=

